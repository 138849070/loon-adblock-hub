[Rewrite]
#游戏
^https?:\/\/(mfjk|gnjk\d*|gnjk3|jk|buyaoda).+\.com\/request_game\/v3\/game\/list.*$ - reject-dict

[Script]
#广告
http-response ^https?:\/\/((mfjk|gnjk\d*|buyaoda).*\.com|jk\.bnhwq672q3\.com)\/(playerinfo|api\/home\/popup|api\/get_?advert).*$ script-path=https://raw.githubusercontent.com/138849070/loon-adblock-hub/main/plugins/video/mjgs/deps/mjgsad.js, requires-body=true, timeout=60, tag=mjgsad

#视频
http-request ^https?:\/\/(mfjk|gnjk\d*|buyaoda|gnjk2\.kzfbz|jk\.bnhwq672q3)\.[a-zA-Z0-9-]+\.com\/(api\/(comic|video|short_movie_info|short_movie_lock|novel|gallery|vip|index|video\/info)|request_rust_video\/ai\/init_info).*$ script-path=https://raw.githubusercontent.com/138849070/loon-adblock-hub/main/plugins/video/mjgs/deps/mjgshd.js, timeout=60, tag=mjgshd

[MITM]
hostname = gnjk.*.com, mfjk.*.com, buyaoda.*.com, jk.*.com, gnjk3.*.com, gnjk1.*.com, gnjk2.*.com

